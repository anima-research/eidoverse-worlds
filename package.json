{
  "name": "eidoverse-worlds",
  "private": true,
  "description": "Root deps serve server/optimize.ts (the store's GLB diet) and server/behaviors.ts (quickjs-emscripten, the runtime-script sandbox \u2014 lazily imported; the sequencer boots without it, scripting just reports itself unavailable). The sequencer core itself stays dependency-free. Client and mcpl keep their own manifests.",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "draco3dgltf": "^1.5.7",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^1.2.0",
    "pngjs": "^7.0.0",
    "quickjs-emscripten": "^0.32.0",
    "sharp": "^0.33.5",
    "three": "^0.184.0",
    "werift": "^0.24.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "playwright": "^1.62.1"
  },
  "scripts": {
    "typecheck:flight": "bunx tsc -p tsconfig.flight.json",
    "test:flight": "bun tools/flight-test.ts",
    "test:flight:headless": "bun tools/flight-headless-test.ts",
    "test:wingfold": "bun tools/wing-fold-presence-test.ts && bun tools/wing-owner-wire-test.ts"
  }
}
