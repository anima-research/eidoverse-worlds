# dependencies
node_modules/
**/node_modules/

# secrets & live tokens — NEVER commit
.sessions.json
/.sessions.json.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].tmp
mcpl/tokens.json
mcpl/state.json
services/voicebot/voices.json
# its pre-reorg home: a box that still has one keeps it out of git
tools/voicebot/voices.json
.env
.env.*
deploy/IDENTITY.md

# runtime world data (logs are chat history; poses/snapshots are live state)
worlds/
worlds-dev/
backups/

# the asset library is fetched at runtime (EIDOVERSE_DIR), not vendored; the server's optimize output
# (OPT_DIR, default assets/opt/: thumbs, store, checks) lands under assets/ too
assets/
*.glb
*.vrm
*.hdr

# ...EXCEPT patched/, the versioned ASSET overlay (§24j — the successor of
# upstream-patched/, which also carried engine-code overrides; those retired
# with the braid and the grass engine moved into client/lib/vegetation/).
# A deliberate asset fix travels with this repo ("every machine gets it via
# ordinary git pull"). `assets/` above matches a directory of that name at
# ANY depth, so without these negations a patched asset is silently
# untracked: it works on the machine that baked it and does not exist for
# anyone else. The directory must be re-included before its files can be —
# git cannot re-include a path whose parent directory is excluded.
!patched/**/assets/
!patched/**/*.glb
!patched/**/*.vrm
!patched/**/*.vrma
!patched/**/*.hdr

# generated
*.zip

# local claude/mcp config
.mcp.json
.memsearch/

# Piper voices are yours, not the engine's: drop a model and its .onnx.json here for ?voice=.
client/voices/
client/accept-*.onnx*

# a SYMLINK named node_modules dodges the dir-only pattern above — the
# worktree-symlink footgun that shipped a Mac path to the VPS (2026-08-12)
node_modules

# macOS Finder droppings -- two got committed in eae165b
.DS_Store
__pycache__/

# surface-parity frames are per-run evidence, not source
notes/surface-parity/

# the protocol gate's sibling checkouts (run.ts --siblings: mcpl/ and services/captionbot/ take them by file:, deploy-vps.sh too)
/.siblings/
# their pre-reorg home, still on an upgraded VPS: ignored so provenance doesn't read the tree as dirty
tools/protocol/.siblings/

# bench outputs: per-run, and they hold the runner's absolute paths
bench/*/out/
