# dependencies
node_modules/
**/node_modules/

# secrets & live tokens — NEVER commit
.sessions.json
mcpl/tokens.json
mcpl/state.json
tools/voicebot/voices.json
.env
.env.*
deploy/IDENTITY.md

# runtime world data (logs are chat history; poses/snapshots are live state)
worlds/
worlds-dev/

# the asset library is fetched at runtime (EIDOVERSE_DIR), not vendored
assets/
*.glb
*.vrm
*.hdr

# ...EXCEPT upstream-patched/, whose whole contract is that a deliberate fork
# of a library file travels with this repo ("every machine gets it via ordinary
# git pull"). `assets/` above matches a directory of that name at ANY depth, so
# without these negations a patched asset is silently untracked: it works on the
# machine that baked it and does not exist for anyone else. The directory must
# be re-included before its files can be — git cannot re-include a path whose
# parent directory is excluded.
!upstream-patched/**/assets/
!upstream-patched/**/*.glb
!upstream-patched/**/*.vrm
!upstream-patched/**/*.vrma
!upstream-patched/**/*.hdr

# generated
assets/opt/thumbs/
*.zip

# local claude/mcp config
.mcp.json
.memsearch/
tools/node_modules/


# Piper voice models: ~60MB each, fetched by the client at runtime
# (user's disk or HuggingFace+OPFS) and never served by us. The .onnx.json
# IS committed — 5,036 bytes as of 2026-08-11 (measured; LF) — it is what
# says what the model is.
client/voices/*.onnx
client/accept-*.onnx*

# a SYMLINK named node_modules dodges the dir-only pattern above — the
# worktree-symlink footgun that shipped a Mac path to the VPS (2026-08-12)
node_modules
client/node_modules
mcpl/node_modules

# scratch worlds for the browser-perf harness (docs/browser-perf-receipt.md)
worlds-lab/
